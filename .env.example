# PostgreSQL Database Configuration
DB_USER=lamarra_user
DB_PASSWORD=lamarra_password
DB_NAME=lamarra_db
DB_HOST=localhost
DB_PORT=5432

# Database Connection URL
DATABASE_URL=postgresql://lamarra_user:lamarra_password@localhost:5432/lamarra_db

# JWT Secret & Auth Config
JWT_SECRET=lamarra_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Server Config
PORT=3001
NODE_ENV=development

# pgAdmin Config (Docker)
PGADMIN_EMAIL=admin@lamarra.com
PGADMIN_PASSWORD=admin123

# Frontend Config
VITE_API_BASE_URL=http://localhost:3001/api/v1
