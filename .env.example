# PostgreSQL Database Configuration
DB_USER=lamarra_user
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
DB_NAME=lamarra_db
DB_HOST=localhost
DB_PORT=5432

# Database Connection URL
DATABASE_URL=postgresql://lamarra_user:YOUR_STRONG_DB_PASSWORD_HERE@localhost:5432/lamarra_db

# SSL Database Verification (Set to false only if using self-signed DB certificates without CA in dev)
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Secret & Auth Config (Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=YOUR_UNIQUE_SECURE_RANDOM_64_CHARACTER_JWT_SECRET_KEY
JWT_EXPIRES_IN=7d

# Server Config
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# pgAdmin Config (Docker)
PGADMIN_EMAIL=admin@lamarra.com
PGADMIN_PASSWORD=YOUR_STRONG_PGADMIN_PASSWORD

# Frontend Config
VITE_API_BASE_URL=http://localhost:3001/api/v1
